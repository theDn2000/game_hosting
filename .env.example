# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Docker Compose reads `.env` automatically. Never commit `.env`.

# Password for the platform PostgreSQL database. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Optional overrides (defaults shown).
# POSTGRES_USER=gamehosting
# POSTGRES_DB=gamehosting
# Host port on 127.0.0.1. Change it if 5432 is taken (for example when Docker
# Desktop and a Docker Engine inside WSL both run on the same machine).
# POSTGRES_PORT=5432

# The API (not Compose) reads these from the environment of the process that
# starts it; see docs/RUNNING.md. Example for the values above:
#   GAME_HOSTING_DATABASE_URL=postgresql+psycopg://gamehosting:<password>@127.0.0.1:5432/gamehosting
